APP_NAME=EnvVault API
# Quick start (SQLite file, no install needed):
DATABASE_URL=sqlite:///./envvault.db
# Production (PostgreSQL) - uncomment and edit:
# DATABASE_URL=postgresql+psycopg2://envvault:change_me@localhost:5432/envvault
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-generated-key-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=http://localhost:5173